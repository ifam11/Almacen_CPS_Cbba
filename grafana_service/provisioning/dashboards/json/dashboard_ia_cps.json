    {
      "id": 15,
      "title": "Histórico de Egresos vs Stock Disponible por Insumo",
      "type": "barchart",
      "gridPos": { "h": 8, "w": 14, "x": 0, "y": 7 },
      "datasource": { "type": "mysql", "uid": "MySQL-Almacen-CPS" },
      "targets": [
        {
          "rawSql": "SELECT i.nombre as metric, COALESCE(SUM(l.cantidad_actual), 0) as 'Stock en Pasillo', i.punto_reorden as 'ROP Actual', i.stock_minimo as 'Stock Mínimo' FROM insumos i LEFT JOIN lotes l ON i.id_insumo = l.id_insumo AND l.estado = 'DISPONIBLE' GROUP BY i.id_insumo, i.nombre, i.punto_reorden, i.stock_minimo ORDER BY i.id_insumo ASC;",
          "format": "table",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": { "fillOpacity": 80 }
        }
      }
    },
    {
      "id": 16,
      "title": "Salidas por Departamento Destino (Demanda Hospitalaria)",
      "type": "piechart",
      "gridPos": { "h": 8, "w": 10, "x": 14, "y": 7 },
      "datasource": { "type": "mysql", "uid": "MySQL-Almacen-CPS" },
      "targets": [
        {
          "rawSql": "SELECT departamento_destino as metric, COUNT(*) as solicitudes FROM solicitudes_despacho GROUP BY departamento_destino;",
          "format": "table",
          "refId": "A"
        }
      ],
      "options": {
        "pieType": "donut",
        "legend": { "displayMode": "table", "placement": "right", "values": ["value", "percent"] }
      }
    },
    {
      "collapsed": false,

      "id": 202,
      "title": "MATRIZ DE PREDICCIÓN RANDOM FOREST Y SUGERENCIAS ROP",
      "type": "row"
    },
    {
      "id": 17,
      "title": "Recomendaciones Algorítmicas de Reorden (Safety Stock +15%)",
      "type": "table",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 16 },
      "datasource": { "type": "mysql", "uid": "MySQL-Almacen-CPS" },
      "targets": [
        {
          "rawSql": "SELECT i.codigo_institucional as 'Código CPS', i.nombre as 'Insumo', i.tipo as 'Tipo', i.stock_minimo as 'Stock Min', i.punto_reorden as 'ROP Actual', ROUND(i.punto_reorden * 1.15) as 'ROP Sugerido (+15% SS)', COALESCE(SUM(l.cantidad_actual), 0) as 'Stock Disponible', CASE WHEN COALESCE(SUM(l.cantidad_actual), 0) <= i.stock_minimo THEN 'QUIEBRE CRÍTICO' WHEN COALESCE(SUM(l.cantidad_actual), 0) <= i.punto_reorden THEN 'REORDENAR YA' ELSE 'NIVEL ÓPTIMO' END as 'Estado IA' FROM insumos i LEFT JOIN lotes l ON i.id_insumo = l.id_insumo AND l.estado = 'DISPONIBLE' GROUP BY i.id_insumo, i.codigo_institucional, i.nombre, i.tipo, i.stock_minimo, i.punto_reorden ORDER BY 'Stock Disponible' ASC;",
          "format": "table",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Estado IA" },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  { "type": "value", "options": { "QUIEBRE CRÍTICO": { "color": "red", "text": "QUIEBRE CRÍTICO" }, "REORDENAR YA": { "color": "orange", "text": "REORDENAR YA" }, "NIVEL ÓPTIMO": { "color": "green", "text": "NIVEL ÓPTIMO" } } }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": { "type": "color-background" }
              }
            ]
          }
        ]
      }
    }
